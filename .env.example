FEEDBOT__TELEGRAM__TOKEN=
# Optional. If empty, the bot writes master.key next to the database.
FEEDBOT__SECRETS__MASTER_KEY=
FEEDBOT__TELEGRAM__MODE=polling
# Unset admin IDs use the empty list from config/default.toml.
# FEEDBOT__YTDLP__BIN=yt-dlp
# FEEDBOT__BILIBILI__CDN=backupUrl
# FEEDBOT__LOG__FORMAT=json

# For the optional telegram-local Compose profile, set all three.
# FEEDBOT__TELEGRAM__API_URL=http://telegram-bot-api:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
